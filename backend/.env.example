# Server Configuration
PORT=3011
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/luxury_fashion_ecommerce

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# Frontend & Admin URLs for CORS
FRONTEND_URL=http://localhost:3008
ADMIN_URL=http://localhost:3009
ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3009

# Payment Gateway (Razorpay - Test or Live)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Courier & Shipping Integration
COURIER_PROVIDER=shiprocket
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
COURIER_WEBHOOK_SECRET=your_courier_webhook_secret

# Email Integration (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=MONOLITH Luxury Atelier <onboarding@resend.dev>

# SMS Integration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Assistant Integration (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# AI Virtual Try-On Integration (Replicate)
REPLICATE_API_TOKEN=your_replicate_api_token
